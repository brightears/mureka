# Mureka API Configuration
# Get your API key from: https://platform.mureka.ai/apiKeys
MUREKA_API_KEY=your_api_key_here
MUREKA_API_URL=https://api.mureka.ai

# Generation Settings
MAX_PARALLEL_JOBS=10
GENERATION_TIMEOUT_SECONDS=300

# Output Directory (optional - defaults to Google Drive if available, otherwise local)
# OUTPUT_DIR=/path/to/custom/output
