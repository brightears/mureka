{
  "name": "mureka-automation",
  "version": "1.0.0",
  "description": "Automated bulk music generation using Mureka API",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "mureka": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mureka",
    "ai-music",
    "music-generation",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.3.0",
    "node-id3": "^0.2.9",
    "ora": "^7.0.0",
    "p-limit": "^5.0.0"
  }
}
